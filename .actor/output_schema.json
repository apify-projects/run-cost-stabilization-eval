{
    "$schema": "https://apify.com/schemas/v1/output.ide.json",
    "actorOutputSchemaVersion": 1,
    "title": "Output schema",
    "properties": {
        "results": {
            "type": "string",
            "title": "Per-Actor stabilization statistics",
